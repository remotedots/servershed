/* Main panel: no background, the terminal's own shows through (ANSI mode).
   Header and footer keep the textual-dark colors.
   Sidebar follows the mockup: bold client headers, blank line between clients,
   selection is a full-width dark-blue bar. */

Screen {
    layout: horizontal;
}

Header, HeaderTitle, HeaderClock, HeaderIcon {
    background: #242F38;
    color: #E0E0E0;
}

Footer, FooterKey, FooterKey .footer-key--description {
    background: #242F38;
    color: #E0E0E0;
}

FooterKey .footer-key--key {
    background: #242F38;
    color: #FFA62B;
    text-style: bold;
}

/* ---------- sidebar ---------- */
#estate {
    width: 36;
    min-width: 24;
    height: 1fr;
    border: none;
    border-right: solid ansi_bright_black;
    padding: 0;
    background: transparent;
    scrollbar-size-vertical: 1;
    scrollbar-background: transparent;
    scrollbar-color: ansi_bright_black;
}

#estate:focus {
    border: none;
    border-right: solid ansi_bright_black;
    background-tint: transparent;
}

#estate > .option-list--option,
#estate > .option-list--option-disabled {
    background: transparent;
    color: ansi_default;
    padding: 0 1;
}

#estate > .option-list--option-disabled {
    text-style: none;           /* client headers: bold comes from the label */
}

#estate > .option-list--option-highlighted,
#estate:focus > .option-list--option-highlighted {
    background: #1D3A57;
    color: #E0E0E0;
    text-style: none;
}

/* mouse hover: light-blue text only (the hover style spans the whole row,
   so an underline would run to the panel edge) */
#estate > .option-list--option-hover {
    background: transparent;
    color: #7FB4E0;
    text-style: none;
}

/* ---------- detail ---------- */
#detail-scroll, #detail {
    background: transparent;
}

#detail-scroll:focus, #detail-scroll:focus-within {
    background-tint: transparent;
}

#detail-scroll {
    width: 1fr;
    padding: 0 2;
    scrollbar-size-vertical: 1;
    scrollbar-background: transparent;
    scrollbar-background-hover: transparent;
    scrollbar-background-active: transparent;
    scrollbar-color: ansi_bright_black;
    scrollbar-color-hover: ansi_white;
    scrollbar-color-active: ansi_white;
}

#detail {
    width: 100%;
}
