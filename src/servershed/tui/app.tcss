/* Main panel (tree + detail) has no background color: the terminal's own
   background shows through. Header and footer keep the theme. Selection in the
   tree is shown with text style and color only. */

Screen {
    layout: horizontal;
    background: ansi_default;
}

#tree, #detail-scroll, #detail {
    background: ansi_default;
}

#tree {
    width: 34;
    min-width: 24;
    border-right: solid $foreground 30%;
    padding: 0 1;
}

#tree > .tree--cursor,
#tree:focus > .tree--cursor,
#tree > .tree--highlight,
#tree > .tree--highlight-line {
    background: ansi_default;
    color: $primary;
    text-style: bold underline;
}

#detail-scroll {
    width: 1fr;
    padding: 0 2;
}

#detail {
    width: 100%;
}
