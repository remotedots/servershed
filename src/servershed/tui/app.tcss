/* Main panel (tree + detail): no background, the terminal's own shows through
   (the app runs in ANSI mode). Header and footer keep the textual-dark colors.
   Tree selection is shown with text style and color only. */

Screen {
    layout: horizontal;
}

Header, HeaderTitle, HeaderClock, HeaderIcon {
    background: #242F38;
    color: #E0E0E0;
}

Footer, FooterKey, FooterKey .footer-key--description {
    background: #242F38;
    color: #E0E0E0;
}

FooterKey .footer-key--key {
    background: #242F38;
    color: #FFA62B;
    text-style: bold;
}

#tree {
    width: 34;
    min-width: 24;
    border-right: solid $foreground 30%;
    padding: 0 1;
}

#tree > .tree--cursor,
#tree:focus > .tree--cursor,
#tree > .tree--highlight,
#tree > .tree--highlight-line {
    background: transparent;
    color: $primary;
    text-style: bold underline;
}

#detail-scroll {
    width: 1fr;
    padding: 0 2;
}

#detail {
    width: 100%;
}
