/* Main panel (tree + detail): no background, the terminal's own shows through
   (the app runs in ANSI mode). Header and footer keep the textual-dark colors.
   Tree selection is shown with text style and color only. */

Screen {
    layout: horizontal;
}

Header, HeaderTitle, HeaderClock, HeaderIcon {
    background: #242F38;
    color: #E0E0E0;
}

Footer, FooterKey, FooterKey .footer-key--description {
    background: #242F38;
    color: #E0E0E0;
}

FooterKey .footer-key--key {
    background: #242F38;
    color: #FFA62B;
    text-style: bold;
}

#tree, #detail-scroll, #detail {
    background: transparent;
}

#tree {
    width: 34;
    min-width: 24;
    border-right: solid $foreground 30%;
    padding: 0 1;
}

/* no focus tint: the panel keeps the terminal background when focused */
#tree:focus, #detail-scroll:focus, #tree:focus-within, #detail-scroll:focus-within {
    background-tint: transparent;
}

#tree > .tree--guides,
#tree > .tree--guides-hover,
#tree > .tree--guides-selected,
#tree:focus > .tree--guides,
#tree:focus > .tree--guides-hover,
#tree:focus > .tree--guides-selected {
    color: ansi_bright_black;
}

#tree > .tree--cursor,
#tree:focus > .tree--cursor,
#tree > .tree--highlight,
#tree > .tree--highlight-line {
    background: transparent;
    color: $primary;
    text-style: bold underline;
}

#detail-scroll {
    width: 1fr;
    padding: 0 2;
    scrollbar-size-vertical: 1;
    scrollbar-background: transparent;
    scrollbar-background-hover: transparent;
    scrollbar-background-active: transparent;
    scrollbar-color: ansi_bright_black;
    scrollbar-color-hover: ansi_white;
    scrollbar-color-active: ansi_white;
}

#detail {
    width: 100%;
}
